# ─────────────────────────────────────────────────────────────
# DEADCV — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── SERVER ────────────────────────────────────────────────────
PORT=3000

# ── ADMIN ─────────────────────────────────────────────────────
# Secret for the /owner operator dashboard.
# Change this before deploying.
ADMIN_SECRET=change_this_to_something_secret_and_long

# ── RAZORPAY ──────────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) for local development.
# Use live keys (rzp_live_...) only in production via Vercel env vars.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret — set this in Razorpay Dashboard → Webhooks → Secret
# Endpoint: https://YOUR-DOMAIN.com/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── PRICING — SINGLE GLOBAL PRICE ─────────────────────────────
# DEADCV has ONE global price: $1 USD everywhere.
# Do NOT create country-specific pricing tiers.
# PRICE_USD is the canonical price in whole dollars.
PRICE_USD=1

# UPI_PRICE_INR: INR amount for UPI deep link (whole rupees).
# This is NOT a separate tier — it is the INR equivalent of $1
# Fixed at ₹96 per spec. The live rate (open.er-api.com) may be shown as reference,
# but the UPI charge is exactly this value. The underlying price remains $1 in all cases.
UPI_PRICE_INR=96

# ── INTERNATIONAL PAYMENTS ────────────────────────────────────
# Set to true ONLY after Razorpay approves international payments on your account.
# Razorpay requires KYC + international payment activation before this works.
# Keep false until explicitly approved. When false, the $1 Razorpay button shows
# an "unavailable" notice; the UPI QR remains fully available for Indian users.
INTERNATIONAL_PAYMENTS_ENABLED=false

# ── UPI — India deep link ─────────────────────────────────────
# UPI_ID is read server-side and exposed via /api/config to build the upi://pay link.
# Never hardcode the real ID in source code.
UPI_ID=yourname@upi
UPI_MERCHANT_NAME=DEADCV

# ── AI — Google Gemini ────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
# Used server-side only. Never expose in frontend code.
# Supports GEMINI_API_KEY or AI_API_KEY (alias)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# ── TEST MODE ───────────────────────────────────────────────────
# Set to true ONLY for local development to bypass real payment.
# When true, a TEST PAYMENT → ROAST button appears on /payment.
# NEVER set to true in production/Vercel.
DEADCV_TEST_MODE=false
